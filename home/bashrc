#My custom changes
PS1='\[\e[32m\]\w\[\e[0m\] ❯ '
alias c='clear'
alias cdc='cd ~ && clear'
alias nv='nvim'
alias swayset='cd ~/.config/sway/config.d/'

# Yazi functioning
function y() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
  command yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd <"$tmp"
  [ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
  rm -f -- "$tmp"
}
# Bind Alt+y to the y function
bind '"\ey": "y\n"'

#Adding directories to PATH variable
