export PATH="/home/$USER/Applications/Gui/:$PATH"
export PATH="/home/$USER/Scripts/pywal/:$PATH"
export PATH="/home/$USER/Scripts/sway/:$PATH"
export PATH="/home/$USER/Applications/Gui/VSCode/bin/:$PATH"
